{
  "manifest_version": 3,
  "name": "Walmart Lowest Unit Price",
  "version": "0.1.0",
  "description": "Re-sorts Walmart listing pages by unit price.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.walmart.com/search*",
    "https://www.walmart.com/browse/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/search*",
        "https://www.walmart.com/browse/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
